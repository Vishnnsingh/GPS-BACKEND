			"description": "Images CRUD + Bulk upload on Google Drive. Requires login (Bearer {{access_token}}).\n\nSet collection variables:\n- drive_folder_id: Google Drive folder id (share folder with service-account email)\n- drive_file_id: filled automatically after upload (from response.file.id)\n\nTip: use ?public=true if you want public links (Drive permission anyone:reader).",
			"item": [
				{
					"name": "Upload Single Image",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"if (pm.response.code === 201) {",
									"  const r = pm.response.json();",
									"  if (r && r.file && r.file.id) {",
									"    pm.collectionVariables.set('drive_file_id', r.file.id);",
									"    console.log('✅ drive_file_id saved:', r.file.id);",
									"  }",
